{
  "name": "phase0-workspace-mcp",
  "description": "Phase 0 proof for fixture-backed workspace MCP starter generation.",
  "include": [
    ".gitignore",
    "app.vue",
    "convex.json",
    "nuxt.config.ts",
    "package.json",
    "convex/**/*.ts",
    "convex/**/*.js",
    "generated/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [".convex/**", ".env.local", ".nuxt/**", ".output/**", "node_modules/**"],
  "generated": [
    {
      "kind": "operationRegistry",
      "operationRefsPath": "generated/operation-refs.ts",
      "operationHandlesPath": "generated/operation-handles/mcp.ts",
      "operationProjectionsPath": "generated/operation-projections.ts",
      "projectOperationRefImport": "@lupinum/trellis/mcp",
      "defineOperationHandleImport": "@lupinum/trellis/mcp",
      "apiImport": "../convex/_generated/api",
      "runtimes": ["mcp", "testing"]
    }
  ]
}
