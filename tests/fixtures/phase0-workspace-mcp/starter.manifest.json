{
  "name": "phase0-workspace-mcp",
  "description": "Phase 0 proof for fixture-backed workspace MCP starter generation.",
  "include": [
    ".gitignore",
    "app.vue",
    "convex.json",
    "nuxt.config.ts",
    "package.json",
    "convex/**/*.ts",
    "convex/**/*.js",
    "generated/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [".convex/**", ".env.local", ".nuxt/**", ".output/**", "node_modules/**"],
  "generated": [
    {
      "kind": "operationRefs",
      "path": "generated/operation-refs.ts",
      "projectOperationRefImport": "@lupinum/trellis/mcp",
      "apiImport": "../convex/_generated/api",
      "descriptorImport": "../shared/features/projects/operations",
      "descriptors": ["createProjectDescriptor", "deleteProjectDescriptor"],
      "refs": [
        {
          "exportName": "createProjectRef",
          "descriptorName": "createProjectDescriptor",
          "projection": "execute",
          "apiPath": ["features", "projects", "domain", "createProject"]
        },
        {
          "exportName": "executeDeleteProjectRef",
          "descriptorName": "deleteProjectDescriptor",
          "projection": "execute",
          "apiPath": ["features", "projects", "domain", "deleteProject"]
        },
        {
          "exportName": "previewDeleteProjectRef",
          "descriptorName": "deleteProjectDescriptor",
          "projection": "preview",
          "apiPath": ["features", "projects", "domain", "previewDeleteProject"]
        }
      ]
    },
    {
      "kind": "operationHandles",
      "path": "generated/operation-handles/mcp.ts",
      "defineOperationHandleImport": "@lupinum/trellis/mcp",
      "descriptorImport": "../../shared/features/projects/operations",
      "refsImport": "../operation-refs",
      "descriptors": ["createProjectDescriptor", "deleteProjectDescriptor"],
      "refs": ["createProjectRef", "executeDeleteProjectRef", "previewDeleteProjectRef"],
      "handles": [
        {
          "exportName": "createProjectHandle",
          "operationId": "projects.create",
          "descriptorName": "createProjectDescriptor",
          "executeRefName": "createProjectRef",
          "runtimes": ["mcp", "testing"]
        },
        {
          "exportName": "deleteProjectHandle",
          "operationId": "projects.delete",
          "descriptorName": "deleteProjectDescriptor",
          "executeRefName": "executeDeleteProjectRef",
          "previewRefName": "previewDeleteProjectRef",
          "runtimes": ["mcp", "testing"]
        }
      ]
    }
  ]
}
