{
  "name": "workspace-mcp",
  "description": "Fixture-backed workspace MCP Trellis starter.",
  "include": [
    ".env.example",
    ".gitignore",
    "AGENTS.md",
    "README.md",
    "app/**",
    "convex/**/*.ts",
    "generated/operation-projections.ts",
    "nuxt.config.ts",
    "package.json",
    "tsconfig.json",
    "server/**",
    "shared/**/*.ts"
  ],
  "exclude": [
    ".convex/**",
    ".env.local",
    ".nuxt/**",
    ".output/**",
    "node_modules/**",
    "coverage/**"
  ],
  "generated": [
    {
      "kind": "operationRegistry",
      "operationRefsPath": "generated/operation-refs.ts",
      "operationHandlesPath": "generated/operation-handles/mcp.ts",
      "operationProjectionsPath": "generated/operation-projections.ts",
      "projectOperationRefImport": "@lupinum/trellis/mcp",
      "defineOperationHandleImport": "@lupinum/trellis/mcp",
      "apiImport": "../convex/_generated/api",
      "runtimes": ["mcp"]
    }
  ],
  "generatedPaths": [
    ".env.example",
    ".gitignore",
    "AGENTS.md",
    "README.md",
    "package.json",
    "tsconfig.json",
    "server/api/.gitkeep",
    "convex/auth.config.ts",
    "convex/convex.config.ts",
    "convex/http.ts",
    "convex/test.setup.ts",
    "generated/operation-projections.ts"
  ]
}
